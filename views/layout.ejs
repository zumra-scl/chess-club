<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" type="text/css" href="/styles.css">
    <title><%= t.siteTitle %></title>
</head>
<body>
    <div id="sailio">
        <nav id="navi">
            <% if (user) { %>
                <ul>
                    <li><a href="<%= p('/viestit') %>"><%= t.nav.messages %></a></li>
                    <li><a href="<%= p('/pelit') %>"><%= t.nav.games %></a></li>
                    <% if (user.yllapitaja == 1) { %>
                        <li><a href="<%= p('/kayttajat') %>"><%= t.nav.users %></a></li>
                        <li><a href="<%= p('/tapahtumat') %>"><%= t.nav.events %></a></li>
                    <% } %>
                    <form action="<%= p('/logout') %>" method="POST">
                    <button type="submit">Logout</button>
                    </form>
                </ul>
            <% } %>
        </nav>
        <main>
            <%- body %>
        </main>
    </div>
</body>
</html>
