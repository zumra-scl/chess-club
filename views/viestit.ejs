<h1><%= t.messages.title %></h1>

<p><%= t.messages.intro %></p>

<form action="<%= p('/viestit') %>" method="post">
    <p><label for="viesti"><%= t.messages.label %></label><br>
    <textarea name="viesti" id="viesti" rows="5" cols="40"></textarea></p>
    <input type="submit" value="<%= t.messages.submit %>">
</form>

<% if (error) { %>
    <p style="color: red"><%= error %></p>
<% } %>

<% viestit.forEach(function(viesti) { %>
    <p><b><%= viesti.nimi %></b><br>
        <%= viesti.viesti %></p>
<% }); %>
